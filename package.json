{
  "name": "read-aloud-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source toolkit for read-aloud speech analysis, CTC decoding, forced alignment, and word-level error detection.",
  "author": "Jayden <33676809+JaydenV8@users.noreply.github.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @readaloudkit/api dev",
    "test": "vp test run",
    "lint": "oxlint .",
    "oxlint": "oxlint .",
    "fmt": "oxfmt .",
    "oxfmt": "oxfmt .",
    "check": "vp check",
    "models:download": "tsx scripts/download-models.ts",
    "analyze": "tsx packages/cli/src/index.ts",
    "corpus:download": "python3 training/download_corpus.py",
    "corpus:prepare": "python3 training/prepare.py",
    "features:extract": "tsx training/extract_features.ts"
  },
  "dependencies": {
    "@readaloudkit/audio": "workspace:*",
    "@readaloudkit/core": "workspace:*",
    "@readaloudkit/features": "workspace:*",
    "@readaloudkit/gop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.24",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["onnxruntime-node"]
  }
}
